{
  "id": "notron.workbench-appearance",
  "name": "workbench-appearance",
  "displayName": "Appearance",
  "description": "Provides generic color and file icon theme selection.",
  "version": "0.1.0",
  "publisher": "notron",
  "engines": {
    "notron": "^0.1.0"
  },
  "main": "./src/extension.ts",
  "activationEvents": ["*"],
  "contributes": {
    "commands": [
      {
        "command": "workbench.action.selectTheme",
        "title": "Preferences: Color Theme",
        "category": "Preferences"
      },
      {
        "command": "workbench.action.selectIconTheme",
        "title": "Preferences: File Icon Theme",
        "category": "Preferences"
      }
    ]
  }
}
