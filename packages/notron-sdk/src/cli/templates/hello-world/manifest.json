{
  "id": "acme.hello-world",
  "name": "hello-world",
  "displayName": "Hello World",
  "description": "Hello world extension for Notron — generated via notron-sdk init",
  "version": "0.1.0",
  "publisher": "acme",
  "engines": {
    "notron": "^0.1.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": ["onCommand:hello-world.hello"],
  "contributes": {
    "commands": [
      {
        "command": "hello-world.hello",
        "title": "Hello World",
        "category": "Hello"
      }
    ]
  },
  "permissions": []
}
