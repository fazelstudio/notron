{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://notron.dev/schemas/manifest.json",
  "title": "Notron Extension Manifest",
  "description": "JSON Schema for Notron extension manifest (ExtensionManifest). Validated by notron-sdk validateManifest().",
  "type": "object",
  "required": ["id", "name", "version", "publisher", "engines", "main", "activationEvents"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique extension id in publisher.name format.",
      "pattern": "^[a-z0-9][a-z0-9_-]*\\.[a-z0-9][a-z0-9_-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "description": "Semver version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "icon": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "categories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "engines": {
      "type": "object",
      "required": ["notron"],
      "additionalProperties": false,
      "properties": {
        "notron": {
          "type": "string",
          "description": "Semver range for Notron compatibility, e.g. ^0.3.0",
          "minLength": 1
        }
      }
    },
    "extensionDependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*\\.[a-z0-9][a-z0-9_-]*$" }
    },
    "extensionPack": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*\\.[a-z0-9][a-z0-9_-]*$" }
    },
    "main": { "type": "string", "minLength": 1, "description": "Relative path to JS entry." },
    "activationEvents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "anyOf": [
          { "enum": ["*", "onUri", "onStartupFinished"] },
          { "pattern": "^onCommand:.+$" },
          { "pattern": "^onLanguage:.+$" },
          { "pattern": "^onView:.+$" },
          { "pattern": "^workspaceContains:.+$" },
          { "pattern": "^onCustomEditor:.+$" }
        ]
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fs:workspace-read",
          "fs:workspace-write",
          "fs:outside-workspace",
          "shell:execute",
          "network:fetch",
          "clipboard:read",
          "clipboard:write"
        ]
      },
      "uniqueItems": true
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "title"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "category": { "type": "string" },
              "icon": { "type": "string" },
              "enablement": { "type": "string" }
            }
          }
        },
        "menus": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "commandPalette",
              "editor/context",
              "editor/title",
              "explorer/context",
              "view/title",
              "view/item/context",
              "tab/context",
              "menubar/file",
              "menubar/edit",
              "menubar/view",
              "menubar/run",
              "menubar/help",
              "pane/context"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["command"],
              "additionalProperties": false,
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "when": { "type": "string" },
                "group": { "type": "string" },
                "alt": { "type": "string" }
              }
            }
          }
        },
        "keybindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "key"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "key": { "type": "string", "minLength": 1 },
              "mac": { "type": "string" },
              "when": { "type": "string" }
            }
          }
        },
        "viewsContainers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "activitybar": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "icon"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "icon": { "type": "string", "minLength": 1 }
                }
              }
            },
            "panel": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "icon"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "icon": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "views": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "enum": ["tree", "webview"] },
                "when": { "type": "string" },
                "icon": { "type": "string" }
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "extensions"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "extensions": { "type": "array", "items": { "type": "string" } },
              "aliases": { "type": "array", "items": { "type": "string" } },
              "configuration": { "type": "string" }
            }
          }
        },
        "grammars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["language", "scopeName", "path"],
            "additionalProperties": false,
            "properties": {
              "language": { "type": "string", "minLength": 1 },
              "scopeName": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "uiTheme", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "uiTheme": { "type": "string", "enum": ["light", "dark"] },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        },
        "iconThemes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        },
        "productIconThemes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        },
        "snippets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["language", "path"],
            "additionalProperties": false,
            "properties": {
              "language": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        },
        "configuration": {
          "type": "object",
          "required": ["title", "properties"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "category": { "type": "string", "minLength": 1 },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "type": "string", "enum": ["string", "number", "boolean", "array", "object"] },
                  "default": {},
                  "description": { "type": "string" },
                  "enum": { "type": "array" }
                }
              }
            }
          }
        },
        "debuggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "label"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "program": { "type": "string" }
            }
          }
        },
        "taskDefinitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
